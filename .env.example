# ── Teamleader Focus OAuth ───────────────────────────────────────────────
# From the Teamleader developer portal (Marketplace integration).
TEAMLEADER_CLIENT_ID=
TEAMLEADER_CLIENT_SECRET=

# Initial refresh token — SEED ONLY. Used once to bootstrap the datastore,
# after which the store owns the (rotating) token and this value is ignored.
# See docs/DEPLOYMENT.md "One-time token seeding".
TEAMLEADER_REFRESH_TOKEN=

# ── Dashboard auth (shared password) ─────────────────────────────────────
DASHBOARD_PASSWORD=
# Random string (e.g. `openssl rand -hex 32`) used to sign the auth cookie.
AUTH_COOKIE_SECRET=

# ── Cron / sync protection ───────────────────────────────────────────────
# Random secret the Vercel cron request must present to trigger /api/sync.
CRON_SECRET=

# ── Production datastore (Upstash Redis) ─────────────────────────────────
# Leave BLANK for local dev — the store falls back to .data/ JSON files.
# In production these are injected by the Vercel Upstash integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Google Ads (tabblad Marketing) ───────────────────────────────────────
# Alleen lokaal, voor `npm run sync:ads`. Niet op Vercel zetten: de app leest
# alleen de tabel ads_daily. Token van de TrueClicks Google Ads MCP.
TRUECLICKS_MCP_TOKEN=
TRUECLICKS_MCP_URL=https://data.trueclicks.com/mcp
GOOGLE_ADS_CUSTOMER_ID=2259199560
